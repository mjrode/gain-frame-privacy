{
  // Cloudflare Workers config for gainframe.app.
  //
  // The site is a static Next.js export (`cd web && npm run build` → web/out)
  // served by Workers Static Assets. `worker/index.ts` runs first to enforce
  // HTTP -> HTTPS canonicalization and handle dynamic endpoints, then
  // delegates all other requests to the asset binding.
  //
  // This file must live at the repo root — that's the Root directory
  // configured for the build in the Cloudflare dashboard.
  "name": "gain-frame-privacy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-24",
  "vars": {
    "SUPABASE_URL": "https://qpctmhhnomeeyajbivne.supabase.co",
    // Publishable key — public by design; used to verify admin bearer
    // tokens against GoTrue for /api/admin/* and /admin-data/*.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_6kXa8qaaix3McgqohdzCkw_HNoZFlKw",
    // Public Slack conversation ID for #gainframe-alerts. The bot token is a
    // Worker secret and is never shipped to the browser.
    "SLACK_REPORT_CHANNEL_ID": "C0BALSSUGJU"
  },
  "assets": {
    "directory": "web/out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "triggers": {
    // 10:05am EDT / 9:05am EST. Report covers trailing 24h and 7d.
    "crons": ["5 14 * * *"]
  },
  "routes": [
    {
      "pattern": "gainframe.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
