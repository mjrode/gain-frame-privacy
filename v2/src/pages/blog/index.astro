---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function formatDate(dateStr: string) {
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<BaseLayout
  title="GainFrame Blog — AI Progress Photos, Body Composition & Training Tips"
  description="Tips, guides, and updates from GainFrame — the AI-powered progress photo app for gym-goers. Learn about body fat tracking, physique scoring, and transformation science."
  canonicalUrl="https://gainframe.app/blog"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "GainFrame Blog",
      "description": "Tips, guides, and updates from GainFrame — the AI-powered progress photo app for gym-goers.",
      "url": "https://gainframe.app/blog",
      "isPartOf": { "@type": "WebSite", "name": "GainFrame", "url": "https://gainframe.app" }
    })} />
  </Fragment>

  <Fragment slot="nav">
    <nav class="blog-nav">
      <div class="container blog-nav-inner">
        <a href="/" class="blog-nav-logo">
          <img src="/assets/favicon.webp" alt="GainFrame" loading="lazy" class="blog-nav-icon">
          <span class="blog-nav-wordmark">GainFrame</span>
        </a>
        <div class="blog-nav-links">
          <a href="/">Home</a>
          <a href="/blog" class="active">Blog</a>
        </div>
      </div>
    </nav>
  </Fragment>

  <!-- Blog Header -->
  <header class="blog-header">
    <div class="container">
      <h1 class="blog-header-title hero-text-stagger">The GainFrame <span class="accent-underline">Blog</span></h1>
      <p class="blog-header-subtitle hero-text-stagger">Tips, training science, and product updates for gym-goers who track with photos.</p>
    </div>
  </header>

  <!-- Early Access Banner -->
  <section class="early-access-banner">
    <div class="container">
      <div class="early-access-inline scroll-reveal">
        <div class="early-access-text">
          <h2>GainFrame is now available</h2>
          <p>Download now from the App Store and start tracking your true progress.</p>
        </div>
        <div class="app-store-wrapper" style="margin-top: 1rem; display: flex; justify-content: center;">
          <a href="https://apps.apple.com/us/app/gainframe-progress-photos/id6759252082" class="app-store-badge-link" target="_blank" rel="noopener">
            <img src="https://developer.apple.com/news/images/download-on-the-app-store-badge.png" alt="Download on the App Store" style="height: 48px; width: auto;" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Post Grid -->
  <section class="blog-grid-section">
    <div class="container">
      <div class="blog-grid margin-top-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="blog-card scroll-reveal">
            <div class="blog-card-image">
              <img src={post.data.coverImage} alt={post.data.coverAlt} loading="lazy">
            </div>
            <div class="blog-card-content">
              <div class="post-meta">
                <span class="post-category">{post.data.category}</span>
                <span class="post-date">{formatDate(post.data.date)}</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="blog-cta">
    <div class="container">
      <div class="blog-cta-card scroll-reveal">
        <h2>Download GainFrame today</h2>
        <p>Start tracking your true progress with AI-powered body composition analysis.</p>
        <div class="blog-cta-actions">
          <div class="app-store-wrapper" style="margin-top: 1rem; display: flex; justify-content: center;">
            <a href="https://apps.apple.com/us/app/gainframe-progress-photos/id6759252082" class="app-store-badge-link" target="_blank" rel="noopener">
              <img src="https://developer.apple.com/news/images/download-on-the-app-store-badge.png" alt="Download on the App Store" style="height: 48px; width: auto;" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
