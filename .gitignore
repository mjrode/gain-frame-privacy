.claude/*
# Claude Code discovers project skills only in .claude/skills/ — these are
# symlinks into .agent/skills/ (the shared source of truth), safe to commit.
!.claude/skills/
client_secret*.json
.DS_Store

# Python bytecode (e.g. .agent/skills/*/__pycache__)
__pycache__/
*.pyc

# Heavy source MP4s - re-encoded web-friendly versions are committed
docs/app-screenshots/1.21/screen-recording-1-21.MP4

# IndexNow ping log — per-machine, grows unbounded; not source
scripts/indexnow-log.csv

# Audit scanner output — temporary working files
_audit/

# Promo video source files — large, not used by live site, kept locally
promo-source/

# Raw progress photos — not used by either site build, kept locally
progress-photos/

# Archived docs assets — not in prebuild TARGETS, not served; kept locally
docs/_archive/
