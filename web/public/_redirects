# Redirects for Cloudflare Workers Static Assets.
# Format: <from> <to> <status>
# Cloudflare matches in order; first hit wins.
# https://developers.cloudflare.com/pages/configuration/redirects/

# ── Old GitHub-Pages .html URLs → clean Next.js routes ──────────────────────
/index.html              /                301
/blog.html               /blog/           301
/comics.html             /comics/         301
/privacy.html            /privacy/        301

# Pages that no longer exist — send to home rather than 404.
/features.html           /                301
/analytics-post.html     /                301

# Legacy Jekyll URLs still indexed by Google (/blog/<slug>/index.html).
# Consolidate to the canonical Next.js route so duplicate URLs stop splitting CTR.
/blog/*/index.html       /blog/:splat/    301

# Duplicate-content consolidation: identical <title> on two posts targeting the
# same query; older post 301s to the newer, better-ranking canonical.
/blog/how-to-read-body-fat-from-photos/   /blog/how-to-estimate-body-fat-from-photo/   301

# Progress-photo cluster consolidation (2026-05-11): two weak niche posts
# folded into the pillar. /best-gym-progress-photo-app/ was only catching
# accidental brand traffic; /best-progress-photo-app-iphone/ had zero search
# data in 90 days. Authority consolidates into the pillar.
/blog/best-gym-progress-photo-app/        /blog/best-progress-photo-apps/   301
/blog/best-progress-photo-app-iphone/     /blog/best-progress-photo-apps/   301

# Skinny-fat consolidation (2026-08-02): the long-form diagnosis post had zero
# impressions in 28 days while the quiz page ranked for the whole query family.
# Signs content folded into the quiz; renders added. Exact-match only — the old
# post's assets/ dir is still hotlinked by two roundups and must keep serving.
/blog/how-to-tell-if-skinny-fat/          /blog/am-i-skinny-fat-quiz/       301

# ── Feature requests / feedback board (Featurebase) ─────────────────────────
# Branded short URL that fronts the public Featurebase board. The same board is
# embedded in-app (FeaturebaseBoardView). 302 (not 301) because it's an external
# SaaS surface whose URL may change. Keep both slash variants (site is
# trailingSlash: true, but inbound links may omit it).
/feedback         https://gainframe.featurebase.app/   302
/feedback/        https://gainframe.featurebase.app/   302
