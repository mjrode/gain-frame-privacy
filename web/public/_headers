# Cache-Control headers for Cloudflare Pages.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Rules apply top-to-bottom and EVERY matching rule's headers are appended —
# a bare Cache-Control in two matching rules ships both values concatenated.
# So the catch-all comes first, and each specific rule detaches its
# Cache-Control (`! Cache-Control`) before setting its own.

# Catch-all: security headers everywhere; short cache so HTML updates
# propagate quickly.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Next.js fingerprinted assets — safe to cache forever.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Static media imported from /public — long cache (paths change rarely; tools
# like CDN purge handle the edge cases).
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Behavior scripts under /assets/ aren't content-hashed like /_next/static/*,
# so the immutable rule above means an edit (e.g. the blog tag-filter logic)
# silently never reaches a browser that already cached the old file — clicks
# just stop doing anything, with no console error. Force revalidation instead.
/assets/*.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/blog/*/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/app-screenshots/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Fonts (referenced from styles.css and the Google Fonts <link> in layouts).
/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Apple App Site Association — Apple's CDN fetches this on first universal-link
# tap. Must be served as application/json (or text/plain) with no redirect and
# no extension. Short cache so a misconfiguration can be corrected fast.
/.well-known/apple-app-site-association
  ! Cache-Control
  Content-Type: application/json
  Cache-Control: public, max-age=3600
